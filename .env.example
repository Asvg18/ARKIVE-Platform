# Postgres container config — consumed by docker-compose.yml.
# Copy this file to .env (gitignored) and adjust if needed for local dev.
POSTGRES_USER=arkive
POSTGRES_PASSWORD=arkive_dev_password
POSTGRES_DB=arkive
POSTGRES_PORT=5432

# --- On-premises deployment (docker-compose.prod.yml) ---
# The address the panel's browsers will type. `localhost` for a single
# demo laptop; the host's LAN IP (e.g. 192.168.1.42) to let other
# machines reach it. See docs/ARKIVE-deployment.md.
ARKIVE_SITE_ADDRESS=localhost

# Signing key for session tokens. Generate a real one — the dev default
# must not be reused for a deployment:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Needed for the AI agents (skill matching, JD extraction, synthesis).
#
# THIS ONE IS FOR THE DOCKER DEPLOYMENT ONLY. If you are running the dev
# server (uvicorn + npm run dev), the key belongs in backend/.env instead
# — app.core.config reads that file, not this one, and putting it here
# leaves the AI silently unconfigured with nothing on screen to say why.
# `python3 scripts/check_setup.py` will tell you which case you are in.
OPENAI_API_KEY=

# Real outbound email (exam-schedule notices, exam-queue waiting notices).
# Same THIS-FILE-VS-backend/.env split as OPENAI_API_KEY above -- this
# copy is for the Docker deployment only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# TLS mode. Leave the default for localhost or a LAN IP — Caddy issues from
# its own local CA, which each client machine must trust once. For a real
# public domain, use a real email address for ACME certificate notices:
#   ARKIVE_TLS_DIRECTIVE=tls you@example.com
ARKIVE_TLS_DIRECTIVE=tls internal

# Where links inside emails point (password resets, staff invitations).
# Leave unset and it follows ARKIVE_SITE_ADDRESS above over https, which
# is what you want. Set it only if people reach ARKIVE at a different
# address from the one this stack serves -- behind another proxy, say.
# Getting this wrong is invisible here and only shows up as a link that
# goes nowhere in somebody else's inbox.
# APP_BASE_URL=https://arkive.mseuf.local

# Whose "the real visitor is X" header the API believes. Caddy sits in
# front of the backend, so without this every request looks like it came
# from Caddy and the two rate limits stop telling visitors apart -- the
# signup cap becomes a cap for the whole system, and the login lockout
# can be pointed at a known user on purpose.
#
# The default matches the network pinned in docker-compose.prod.yml, so
# it means "trust our own proxy and nothing else". Change it only
# alongside that subnet. Never set it to "*": that makes the API believe
# the part of the header a caller can type, and both limits stop working
# altogether.
FORWARDED_ALLOW_IPS=172.28.0.0/24

# Database dumps contain applicant data and are never part of a deployment.

# Optional: use a managed Postgres (Neon, Supabase, a provider's own)
# instead of the bundled container. Leave unset to use the container.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
