# Backend app config. Copy to backend/.env (gitignored) for local dev.
# Values here must match the Postgres container config in the root .env.
DATABASE_URL=postgresql+psycopg://arkive:arkive_dev_password@localhost:5432/arkive

# JWT signing. Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Real GPT-4o-mini calls for JD extraction (Job Opening Builder). Create a
# key at https://platform.openai.com/api-keys and paste it below — leave
# unset locally and the extraction endpoint just returns a clear error
# instead of crashing the app.
# ^ This is the file the dev server reads. There is a second
# OPENAI_API_KEY line in the repo-root .env — that one is for the Docker
# deployment and has no effect on `uvicorn`. Run
# `python3 scripts/check_setup.py` if the AI says it is not configured.
OPENAI_API_KEY=

# Real outbound email (exam-schedule notices, exam-queue waiting notices).
# Any standard SMTP account works -- e.g. a Gmail account with an App
# Password (not your normal login password: myaccount.google.com/apppasswords),
# or your institution's mail relay. Leave SMTP_HOST unset locally and
# sending just logs and no-ops instead of crashing -- the in-app
# notification still goes out either way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Browser origins allowed to call this API, comma-separated. Leave as-is
# for local dev. To let teammates reach this machine over a LAN, add the
# host's LAN address as the frontend will be served from it, e.g.:
#   CORS_ORIGINS=http://localhost:5173,http://192.168.1.42:5173
# and start uvicorn with --host 0.0.0.0 so it listens beyond loopback.
CORS_ORIGINS=http://localhost:5173

# LLM-written retrieval probes in the hybrid-RAG pipeline's Context Router
# and Clarify agents (app/services/agents/rag_catalog.py).
#
# A job requirement makes a poor search query: "Strong communication
# skills" shares no words with "presented quarterly findings to the dean",
# so neither BM25 nor the embedding half reliably finds the evidence that
# does exist. With this on, one model call per pre-screening rewrites each
# requirement into probes phrased as resume evidence, and those retrieve
# alongside the original requirement rather than instead of it.
#
# Costs one extra model call and one extra embedding batch per applicant,
# on a request they are waiting on, and measured no better on the labelled
# evaluation set (scripts/eval_skill_matching.py). Off by default; see
# app/infra/config.py.
RAG_QUERY_EXPANSION=false
